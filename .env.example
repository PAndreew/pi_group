# Copy to .env (next to this file or in server/) and adjust.

HOST=0.0.0.0
PORT=8787

# Everything the file browser can reach. Users cannot leave this directory.
FS_ROOT=~/projects

# App state: users, logins, session sharing, pi-durable SQLite files.
DATA_DIR=~/.pi-group

# First start only: the admin account. Without ADMIN_PASSWORD a random one is printed to the log.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please

# pi executable (global install: "pi"). A path to a .js file is run with node.
PI_BIN=pi
# PI_SESSIONS_DIR=~/.pi/agent/sessions
# PI_CODING_AGENT_DIR=~/.pi/agent

# Idle pi processes (not running, nobody watching, not pinned) stop after this many minutes.
IDLE_TIMEOUT_MIN=30
MAX_UPLOAD_MB=200

# Set to true when served over HTTPS (reverse proxy, Tailscale serve, ...).
COOKIE_SECURE=false
LOGIN_TTL_DAYS=30

# pi-durable adapter (in-process, SQLite). Set false to only offer pi over RPC.
ENABLE_DURABLE=true
# Offline demo model for trying the UI without API keys (pi durable harness only).
# PI_GROUP_DEMO_MODEL=1

# Chats: shared folder for chats without a #folder (inside FS_ROOT); it also holds MEMORY.md.
# CHAT_FOLDER=~/pi-chat
# Consolidate chats untouched for this many days into memory (0 = off).
MEMORY_AFTER_DAYS=7

# Shared browser (docs/browser.md): Chromium/Chrome/Edge binary (auto-detected when unset),
# minutes before an unwatched browser closes, and how many can be open at once.
# BROWSER_EXECUTABLE=/usr/bin/chromium
# BROWSER_IDLE_MIN=10
# BROWSER_MAX_SESSIONS=4

# Web Push: contact sent to push services. Keys are generated into DATA_DIR/vapid.json unless set.
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional paid Cloudflare assistance (Clef + Clairic share one account-scoped Workers AI token).
# All three user settings switches default off. See docs/cloudflare-assistance.md.
# CLOUDFLARE_ACCOUNT_ID=
# Preferred: reference a key in each initiating user's per-tenant vault (value stays in the vault).
# CLOUDFLARE_VAULT_KEY=CLOUDFLARE_WORKER_KEY
# Alternative: a shared server-only token, used instead of the vault when set.
# CLOUDFLARE_API_TOKEN=

# Secret vault (vault/, a separate service: npm run start:vault). Beezy and the vault share VAULT_TOKEN;
# generate one with `openssl rand -hex 32`. Without it the vault menu explains how to set it up.
# VAULT_TOKEN=
# Where Beezy reaches the vault (default http://127.0.0.1:8790 when VAULT_TOKEN is set).
# VAULT_URL=http://127.0.0.1:8790
# Vault side only: listen address, data directory, and optionally the master key (32 bytes, base64 or hex).
# Without VAULT_MASTER_KEY a key is generated into VAULT_DATA_DIR/master.key; back it up.
# VAULT_HOST=127.0.0.1
# VAULT_PORT=8790
# VAULT_DATA_DIR=~/.beezy-vault
# VAULT_MASTER_KEY=
