{
  "name": "pi-group-server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('extensions', 'dist/extensions', { recursive: true })\"",
    "start": "node dist/index.js",
    "user": "node dist/cli.js",
    "user:dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "@earendil-works/chord": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-durable": "^1.2.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
