# Copy to .env (next to this file or in server/) and adjust.

HOST=0.0.0.0
PORT=8787

# Everything the file browser can reach. Users cannot leave this directory.
FS_ROOT=~/projects

# App state: users, logins, session sharing, pi-durable SQLite files.
DATA_DIR=~/.pi-group

# First start only: the admin account. Without ADMIN_PASSWORD a random one is printed to the log.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please

# pi executable (global install: "pi"). A path to a .js file is run with node.
PI_BIN=pi
# PI_SESSIONS_DIR=~/.pi/agent/sessions
# PI_CODING_AGENT_DIR=~/.pi/agent

# Idle pi processes (not running, nobody watching, not pinned) stop after this many minutes.
IDLE_TIMEOUT_MIN=30
MAX_UPLOAD_MB=200

# Set to true when served over HTTPS (reverse proxy, Tailscale serve, ...).
COOKIE_SECURE=false
LOGIN_TTL_DAYS=30

# pi-durable adapter (in-process, SQLite). Set false to only offer pi over RPC.
ENABLE_DURABLE=true
# Offline demo model for trying the UI without API keys (pi durable harness only).
# PI_GROUP_DEMO_MODEL=1
